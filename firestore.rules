rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBoundedString(value, max) {
      return value is string && value.size() <= max;
    }

    function optionalString(data, field, max) {
      return !(field in data) || data[field] == null || isBoundedString(data[field], max);
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    function optionalNumber(data, field, min, max) {
      return !(field in data)
        || data[field] == null
        || (data[field] is number && data[field] >= min && data[field] <= max);
    }

    function optionalInt(data, field, min, max) {
      return !(field in data)
        || data[field] == null
        || (data[field] is int && data[field] >= min && data[field] <= max);
    }

    function validScheduleTimes(data) {
      return !("scheduleTimes" in data)
        || data.scheduleTimes == null
        || (
          data.scheduleTimes is list
          && data.scheduleTimes.size() <= 4
          && data.scheduleTimes.hasOnly(["morning", "midday", "evening", "bedtime"])
        );
    }

    function validSupplement(data, userId) {
      return data.keys().hasOnly([
          "name", "brand", "dosage", "frequency", "scheduleTimes", "notes",
          "startDate", "imageUrl", "userId", "createdAt", "updatedAt"
        ])
        && data.userId == userId
        && isBoundedString(data.name, 200)
        && data.name.size() > 0
        && optionalString(data, "brand", 200)
        && optionalString(data, "dosage", 120)
        && optionalString(data, "frequency", 120)
        && optionalString(data, "notes", 5000)
        && optionalString(data, "imageUrl", 2000)
        && validScheduleTimes(data)
        && optionalTimestamp(data, "startDate")
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validHealthMetric(data, userId) {
      return data.keys().hasOnly([
          "userId", "dateId", "date", "energyLevel", "sleepQuality", "mood",
          "focus", "stressLevel", "sleepHours", "weight", "weightUnit",
          "bloodPressure", "customMetrics", "notes", "createdAt", "updatedAt"
        ])
        && data.keys().size() <= 20
        && data.userId == userId
        && isBoundedString(data.dateId, 10)
        && data.date is timestamp
        && optionalInt(data, "energyLevel", 1, 10)
        && optionalInt(data, "sleepQuality", 1, 10)
        && optionalInt(data, "mood", 1, 10)
        && optionalInt(data, "focus", 1, 10)
        && optionalInt(data, "stressLevel", 1, 10)
        && optionalNumber(data, "sleepHours", 0, 24)
        && optionalNumber(data, "weight", 0, 1000)
        && (
          !("weightUnit" in data)
          || data.weightUnit == null
          || data.weightUnit in ["kg", "lbs"]
        )
        && optionalString(data, "notes", 5000)
        && (!("bloodPressure" in data) || data.bloodPressure == null || (data.bloodPressure is map && data.bloodPressure.size() <= 4))
        && (!("customMetrics" in data) || data.customMetrics == null || (data.customMetrics is map && data.customMetrics.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSideEffect(data, userId) {
      return data.keys().hasOnly([
          "userId", "date", "dateId", "supplementIds", "supplementNames",
          "symptom", "category", "severity", "startTime", "endTime", "duration",
          "resolved", "resolvedAt", "resolution", "notes", "createdAt", "updatedAt"
        ])
        && data.userId == userId
        && data.date is timestamp
        && isBoundedString(data.dateId, 10)
        && data.supplementIds is list
        && data.supplementIds.size() <= 30
        && data.supplementNames is list
        && data.supplementNames.size() <= 30
        && isBoundedString(data.symptom, 200)
        && data.symptom.size() > 0
        && data.category in [
          "digestive", "neurological", "skin", "cardiovascular",
          "musculoskeletal", "sleep", "mood", "other"
        ]
        && data.severity in ["mild", "moderate", "severe"]
        && data.resolved is bool
        && optionalTimestamp(data, "startTime")
        && optionalTimestamp(data, "endTime")
        && optionalTimestamp(data, "resolvedAt")
        && optionalString(data, "duration", 120)
        && optionalString(data, "resolution", 2000)
        && optionalString(data, "notes", 5000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validDoseLog(data, userId) {
      return data.keys().hasOnly([
          "userId", "dateId", "takenEntryIds", "entries", "completionRate",
          "createdAt", "updatedAt"
        ])
        && data.userId == userId
        && isBoundedString(data.dateId, 10)
        && data.takenEntryIds is list
        && data.takenEntryIds.size() <= 200
        && data.entries is list
        && data.entries.size() <= 200
        && data.completionRate is number
        && data.completionRate >= 0
        && data.completionRate <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSearch(data) {
      return data.keys().hasOnly([
          "query", "response", "category", "timestamp", "isBookmarked", "bookmarkedAt"
        ])
        && isBoundedString(data.query, 8000)
        && data.query.size() > 0
        && isBoundedString(data.response, 100000)
        && data.category in ["general", "benefits", "dosing", "interactions", "stacking", "evidence"]
        && data.timestamp is timestamp
        && data.isBookmarked is bool
        && optionalTimestamp(data, "bookmarkedAt");
    }

    match /supplements/{supplementId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        validSupplement(request.resource.data, request.auth.uid);

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        validSupplement(request.resource.data, request.auth.uid);

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().size() <= 32;
      allow delete: if isOwner(userId);

      match /healthMetrics/{metricId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validHealthMetric(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /sideEffects/{effectId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSideEffect(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /doseLogs/{logId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validDoseLog(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /searches/{searchId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSearch(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /stats/{statId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }
  }
}
